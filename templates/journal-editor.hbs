<section class="ls-rich-journal-shell">
  <header class="ls-rich-journal-heading">
    <div>
      <small>{{journalName}}</small>
      <input name="pageName" type="text" value="{{pageName}}" aria-label="Page title">
    </div>
    <span><i class="fa-solid fa-feather-pointed"></i> Rich Journal page</span>
  </header>
  <div class="ls-rich-journal-hint"><i class="fa-solid fa-link"></i> Type <kbd>[[</kbd> to link or create another page. Use Foundry's toolbar for headings, lists, tables, images, links, and formatting.</div>
  <div class="ls-rich-journal-surface" data-role="editor"></div>
  <footer>
    <span data-role="status">Saved</span>
    <span data-role="word-count">0 words</span>
    <span class="spacer"></span>
    <button type="button" data-action="cancel"><i class="fa-solid fa-xmark"></i> Cancel</button>
    <button type="button" class="primary" data-action="save"><i class="fa-solid fa-floppy-disk"></i> Save page</button>
  </footer>
</section>
