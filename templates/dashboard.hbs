<div class="lore-smith">
  <aside class="ls-sidebar">
    <div class="ls-brand">
      <i class="fa-solid fa-book-sparkles"></i>
      <div><strong>Lore Smith</strong><small>PF2e GM Workspace</small></div>
    </div>
    <nav>
      <button type="button" data-action="dashboardTab" data-tab="campaign" class="{{#if tabs.campaign}}active{{/if}}"><i class="fa-solid fa-map"></i> Campaign Builder</button>
      <button type="button" data-action="dashboardTab" data-tab="campaignMap" class="{{#if tabs.campaignMap}}active{{/if}}"><i class="fa-solid fa-map-location-dot"></i> Campaign Map Builder</button>
      <button type="button" data-action="dashboardTab" data-tab="worldMap" class="{{#if tabs.worldMap}}active{{/if}}"><i class="fa-solid fa-earth-europe"></i> World Map Builder</button>
      <button type="button" data-action="dashboardTab" data-tab="session" class="{{#if tabs.session}}active{{/if}}"><i class="fa-solid fa-compass"></i> Session Prep</button>
      <button type="button" data-action="dashboardTab" data-tab="loot" class="{{#if tabs.loot}}active{{/if}}"><i class="fa-solid fa-gem"></i> Loot & Treasure</button>
    </nav>
    <p class="ls-prototype">Prototype: simulator results can contain bugs or unusual AI choices.</p>
  </aside>

  <main class="ls-main">
    {{#if tabs.worldMap}}
      <section class="ls-panel ls-world-panel">
        <header><div><span>Territorial worldbuilding atlas</span><h1>World Map Builder</h1></div><div class="ls-header-actions"><button type="button" data-action="newWorldMapBuild"><i class="fa-solid fa-rotate-left"></i> Start over</button><button type="button" data-action="createWorldAtlas"><i class="fa-solid fa-book-atlas"></i> {{#if worldMapAtlasAvailable}}Update{{else}}Create{{/if}} world atlas</button></div></header>
        <p class="ls-lead">Draw real territorial regions over your map, nest smaller areas inside larger ones, and develop each region only as far as play requires. Every region can become its own native Foundry Journal.</p>

        <div class="ls-world-map-heading">
          <label>World or atlas name<input name="worldMapName" value="{{worldMap.name}}" placeholder="Dominion of Kryta"></label>
          <label>World map<span class="ls-inline-control"><input value="{{worldMapView.image}}" readonly placeholder="Choose a world map"><button type="button" data-action="browseWorldMap">Browse</button></span></label>
        </div>
        <div class="ls-map-toolbar">
          <button type="button" data-action="activateWorldRegionTool" class="{{#if worldMapDrawing}}active{{/if}}"><i class="fa-solid fa-draw-polygon"></i> Draw region</button>
          {{#if worldMapDrawing}}<button type="button" data-action="cancelWorldRegionTool"><i class="fa-solid fa-xmark"></i> Cancel drawing</button>{{/if}}
          <button type="button" data-action="resetWorldMapView"><i class="fa-solid fa-magnifying-glass-minus"></i> Reset view</button>
          <button type="button" data-action="toggleLoreSmithFullscreen"><i class="fa-solid fa-expand"></i> Full screen</button>
          <span>{{#if worldMapDrawing}}Left-click corners · Double-click or Enter to close · Backspace removes a corner · Escape cancels{{else}}Wheel: zoom · Middle-drag: pan · Left-click: select · Drag a corner: reshape · Double-click: open region Journal{{/if}}</span>
        </div>

        <div class="ls-world-workspace">
          <aside class="ls-world-region-list">
            <header><strong>Regions</strong><span>{{worldMapRegions.length}}</span></header>
            <div>{{#each worldMapRegions}}<button type="button" data-action="selectWorldRegion" data-id="{{id}}" class="{{#if selected}}active{{/if}}"><i class="fa-solid {{icon}}" style="color:{{color}}"></i><span>{{#if name}}{{name}}{{else}}Unnamed region{{/if}}<small>{{typeLabel}} · {{developmentLabel}}</small></span></button>{{else}}<p>No regions yet. Choose <strong>Draw region</strong> and trace the first boundary.</p>{{/each}}</div>
            {{#if worldMapSameSource}}<small class="ls-world-source-note"><i class="fa-solid fa-location-dot"></i> Campaign Map points are shown and assigned automatically.</small>{{else}}<small class="ls-world-source-note"><i class="fa-solid fa-circle-info"></i> Use the same map in Campaign Map Builder to show its named points here.</small>{{/if}}
          </aside>

          <div class="ls-world-map {{#if worldMapDrawing}}drawing{{/if}}" data-world-map>
            {{#if worldMapView.hasImage}}
              <div class="ls-world-map-stage" data-world-map-stage style="transform:translate({{worldMapView.panX}}px,{{worldMapView.panY}}px) scale({{worldMapView.zoom}})">
                <img data-world-map-image src="{{worldMapView.image}}" alt="{{worldMap.name}} world map">
                <svg class="ls-world-region-layer" viewBox="0 0 1000 1000" preserveAspectRatio="none" aria-label="World regions">
                  {{#each worldMapRegions}}<polygon data-world-region-id="{{id}}" class="ls-world-region {{#if selected}}selected{{/if}}" points="{{points}}" style="--region-color:{{color}};--region-opacity:{{opacity}}"></polygon>{{/each}}
                  <polyline data-world-region-draft class="ls-world-region-draft" points="{{worldMapDraftPoints}}"></polyline>
                </svg>
                {{#each worldMapRegions}}
                  <button type="button" data-world-region-label="{{id}}" data-world-region-id="{{id}}" class="ls-world-region-label {{#if selected}}selected{{/if}}" style="left:{{labelLeft}};top:{{labelTop}};--world-marker-scale:{{labelScale}}"><i class="fa-solid {{icon}}"></i><span>{{#if name}}{{name}}{{else}}Unnamed region{{/if}}</span></button>
                  {{#if selected}}{{#each vertexViews}}<button type="button" data-world-region-id="{{../id}}" data-world-region-vertex="{{index}}" class="ls-world-region-vertex" style="left:{{left}};top:{{top}};--world-marker-scale:{{markerScale}}" aria-label="Move region corner"></button>{{/each}}{{/if}}
                {{/each}}
                {{#each worldMapPoints}}<span data-world-map-point class="ls-world-map-point" style="left:{{left}};top:{{top}}" title="{{name}}{{#if primaryRegionName}} · {{primaryRegionName}}{{/if}}"><i class="fa-solid {{icon}}"></i></span>{{/each}}
              </div>
            {{else}}<div class="ls-region-map-empty"><i class="fa-solid fa-earth-europe"></i><strong>Choose a world map to begin</strong></div>{{/if}}
          </div>

          <aside class="ls-world-inspector">
            {{#if worldMapSelectedRegion}}
              <div data-world-region-editor="{{worldMapSelectedRegion.id}}">
                <header><div><span>Selected region</span><strong>{{#if worldMapSelectedRegion.name}}{{worldMapSelectedRegion.name}}{{else}}Unnamed region{{/if}}</strong></div><button type="button" data-action="deleteWorldRegion" data-id="{{worldMapSelectedRegion.id}}" title="Delete region"><i class="fa-solid fa-trash"></i></button></header>
                <label>Region name<input data-world-region-field="name" value="{{worldMapSelectedRegion.name}}" placeholder="Northern Marches"></label>
                <div class="ls-world-inspector-grid"><label>Region type<select data-world-region-field="type">{{#each worldMapSelectedRegion.typeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label>Preparation level<select data-world-region-field="development">{{#each worldMapSelectedRegion.developmentOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label></div>
                <label>Part of<select data-world-region-field="parentId">{{#each worldMapSelectedRegion.parentOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                <div class="ls-world-style-row"><label>Colour<input type="color" data-world-region-field="color" value="{{worldMapSelectedRegion.color}}"></label><label>Fill opacity<input type="range" data-world-region-field="opacity" min="0.08" max="0.72" step="0.02" value="{{worldMapSelectedRegion.opacity}}"></label></div>
                <label>Regional identity<textarea data-world-region-field="summary" rows="2" placeholder="What immediately distinguishes this region?">{{worldMapSelectedRegion.summary}}</textarea></label>
                <details open><summary>Land and travel</summary><label>Terrain<textarea data-world-region-field="terrain" rows="2">{{worldMapSelectedRegion.terrain}}</textarea></label><label>Climate<textarea data-world-region-field="climate" rows="2">{{worldMapSelectedRegion.climate}}</textarea></label><label>Travel and connections<textarea data-world-region-field="travel" rows="2">{{worldMapSelectedRegion.travel}}</textarea></label></details>
                <details><summary>People and power</summary><label>Inhabitants<textarea data-world-region-field="inhabitants" rows="2">{{worldMapSelectedRegion.inhabitants}}</textarea></label><label>Authority and law<textarea data-world-region-field="authority" rows="2">{{worldMapSelectedRegion.authority}}</textarea></label><label>Culture and identity<textarea data-world-region-field="culture" rows="2">{{worldMapSelectedRegion.culture}}</textarea></label><label>Resources and trade<textarea data-world-region-field="resources" rows="2">{{worldMapSelectedRegion.resources}}</textarea></label><label>Factions<textarea data-world-region-field="factions" rows="2">{{worldMapSelectedRegion.factions}}</textarea></label></details>
                <details><summary>What matters in play</summary><label>Current situation<textarea data-world-region-field="currentSituation" rows="2">{{worldMapSelectedRegion.currentSituation}}</textarea></label><label>Dangers and pressures<textarea data-world-region-field="dangers" rows="2">{{worldMapSelectedRegion.dangers}}</textarea></label><label>Adventure hooks<textarea data-world-region-field="hooks" rows="2">{{worldMapSelectedRegion.hooks}}</textarea></label></details>
                {{#if worldMapSelectedRegion.containedLocations.length}}<details><summary>Places inside · {{worldMapSelectedRegion.containedLocations.length}}</summary><ul>{{#each worldMapSelectedRegion.containedLocations}}<li>{{name}} <small>{{type}}</small></li>{{/each}}</ul></details>{{/if}}
                {{#if worldMapSelectedRegion.childRegions.length}}<details><summary>Subregions · {{worldMapSelectedRegion.childRegions.length}}</summary><ul>{{#each worldMapSelectedRegion.childRegions}}<li>{{name}}</li>{{/each}}</ul></details>{{/if}}
                <button type="button" class="ls-world-journal-button" data-action="openWorldRegionJournal" data-id="{{worldMapSelectedRegion.id}}"><i class="fa-solid fa-book-open"></i> {{#if worldMapSelectedRegion.journalAvailable}}Update and open{{else}}Create{{/if}} region Journal</button>
              </div>
            {{else}}<div class="ls-world-inspector-empty"><i class="fa-solid fa-hand-pointer"></i><strong>Select a region</strong><p>Its worldbuilding guidance and Foundry Journal controls will appear here.</p></div>{{/if}}
          </aside>
        </div>
        {{#if worldMapValidation.length}}<div class="ls-warning ls-world-validation"><strong>Before creating the atlas:</strong>{{#each worldMapValidation}}<div>{{this}}</div>{{/each}}</div>{{/if}}
        <footer class="ls-world-footer"><span><i class="fa-solid fa-cloud-arrow-up"></i> Every edit is recovered immediately and saved to this Foundry world.</span><span>Double-click any completed region to open its Journal.</span></footer>
      </section>
    {{/if}}

    {{#if tabs.campaignMap}}
      <section class="ls-panel ls-campaign-panel">
        <header><div><span>Progressive regional campaign authoring</span><h1>Campaign Map Builder</h1></div><div class="ls-header-actions"><button data-action="newCampaignBuild"><i class="fa-solid fa-rotate-left"></i> Start over</button><button data-action="openCampaignJournal" {{#unless campaignJournalAvailable}}disabled{{/unless}}><i class="fa-solid fa-book-open"></i> Open campaign</button></div></header>
        <p class="ls-lead">Build outward from a real regional map. Prepare the starting point deeply, nearby places enough to visit, and distant places only enough to mention until play moves toward them.</p>
        <div class="ls-session-progress ls-campaign-progress" aria-label="Campaign builder progress">{{#each campaignSteps}}<button data-action="goToCampaignStep" data-step="{{index}}" class="{{#if active}}active{{/if}}"><span>{{number}}</span>{{label}}</button>{{/each}}</div>

        {{#if campaignSteps.map.active}}
          <section class="ls-session-step"><div class="ls-step-kicker">Step 1 of 8</div><h2>Upload and mark the regional map</h2><p>Upload the map, then right-click every settlement, landmark, ruin, lake, mountain range, road, or other place you want the builder to understand.</p><div class="ls-session-form"><label>Campaign name<input name="campaignName" value="{{campaign.name}}" placeholder="Dominion of Kryta"></label><label>Starting level<input type="number" name="campaignStartingLevel" min="1" max="20" value="{{campaign.startingLevel}}"></label><label class="wide">Regional map<span class="ls-inline-control"><input value="{{campaignMap.image}}" readonly placeholder="Choose a regional map"><button type="button" data-action="browseCampaignMap">Browse</button></span></label></div>
          <div class="ls-map-toolbar"><button type="button" data-action="resetCampaignMapView"><i class="fa-solid fa-magnifying-glass-minus"></i> Reset view</button><button type="button" data-action="toggleLoreSmithFullscreen"><i class="fa-solid fa-expand"></i> Full screen</button><span>Mouse wheel: zoom · Middle-drag: pan · Right-click: add or edit a point · Left-drag: move a point</span></div>
          <div class="ls-region-map" data-campaign-map>{{#if campaignMap.hasImage}}<div class="ls-region-map-stage" data-campaign-map-stage style="transform:translate({{campaignMap.panX}}px,{{campaignMap.panY}}px) scale({{campaignMap.zoom}})"><img data-campaign-map-image src="{{campaignMap.image}}" alt="Regional campaign map"><div class="ls-map-focus-circle" style="left:{{campaignMap.focusLeft}};top:{{campaignMap.focusTop}};width:{{campaignMap.focusSize}};height:{{campaignMap.focusHeight}}"></div>{{#each campaignMapMarkers}}{{#if positioned}}<button type="button" data-action="selectCampaignMarker" data-id="{{id}}" data-campaign-marker-id="{{id}}" class="ls-map-marker {{band}}" style="left:{{left}};top:{{top}};--marker-scale:{{markerScale}}" title="Left-click to select; left-drag to move; right-click to edit"><i class="fa-solid {{icon}}"></i><span>{{#if name}}{{name}}{{else}}Point {{number}}{{/if}}</span></button>{{/if}}{{/each}}</div>{{else}}<div class="ls-region-map-empty"><i class="fa-solid fa-map"></i><strong>Choose a regional map to begin</strong></div>{{/if}}</div>
          <div class="ls-campaign-entry-stack">{{#each campaignMapMarkers}}<article data-campaign-entry-kind="locations" data-campaign-entry-id="{{id}}"><header><strong>Point {{number}} · {{band}}</strong><button data-action="removeCampaignMarker" data-id="{{id}}"><i class="fa-solid fa-trash"></i></button></header><div class="ls-session-form"><label>Name<input data-campaign-field="name" value="{{name}}" placeholder="Cassardis"></label><label>Type<select data-campaign-field="type">{{#each typeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label></div></article>{{/each}}</div></section>
        {{/if}}

        {{#if campaignSteps.focus.active}}
          <section class="ls-session-step"><div class="ls-step-kicker">Step 2 of 8</div><h2>Draw the starting area</h2><p>Choose the starting point, turn on <strong>Draw starting area</strong>, then press and drag on the map to set the circle's radius from that point.</p><div class="ls-session-form"><label class="wide">Starting point<select name="campaignStartLocation">{{#each campaignStartOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label></div><div class="ls-map-toolbar"><button type="button" data-action="activateCampaignMapTool" data-tool="focus" class="{{#if campaignMapFocusTool}}active{{/if}}"><i class="fa-solid fa-circle-dot"></i> Draw starting area</button>{{#if campaignMapTool}}<button type="button" data-action="cancelCampaignMapTool"><i class="fa-solid fa-xmark"></i> Cancel tool</button>{{/if}}<button type="button" data-action="resetCampaignMapView"><i class="fa-solid fa-magnifying-glass-minus"></i> Reset view</button><button type="button" data-action="toggleLoreSmithFullscreen"><i class="fa-solid fa-expand"></i> Full screen</button><span>Mouse wheel: zoom · Middle-drag: pan · Right-click: add or edit · Left-drag: move</span><strong>{{campaignMap.startName}}</strong></div><div class="ls-region-map {{#if campaignMapFocusTool}}drawing-focus{{/if}}" data-campaign-map>{{#if campaignMap.hasImage}}<div class="ls-region-map-stage" data-campaign-map-stage style="transform:translate({{campaignMap.panX}}px,{{campaignMap.panY}}px) scale({{campaignMap.zoom}})"><img data-campaign-map-image src="{{campaignMap.image}}" alt="Regional campaign map"><div class="ls-map-focus-circle" style="left:{{campaignMap.focusLeft}};top:{{campaignMap.focusTop}};width:{{campaignMap.focusSize}};height:{{campaignMap.focusHeight}}"></div>{{#each campaignMapMarkers}}{{#if positioned}}<button type="button" data-action="selectCampaignMarker" data-id="{{id}}" data-campaign-marker-id="{{id}}" class="ls-map-marker {{band}}" style="left:{{left}};top:{{top}};--marker-scale:{{markerScale}}" title="Click to choose this starting point; drag to move it; right-click to edit"><i class="fa-solid {{icon}}"></i><span>{{#if name}}{{name}}{{else}}Point {{number}}{{/if}}</span></button>{{/if}}{{/each}}</div>{{else}}<div class="ls-region-map-empty"><i class="fa-solid fa-map"></i><strong>Choose a regional map first</strong></div>{{/if}}</div><aside class="ls-campaign-guidance"><strong>Current result</strong><p>{{campaignCenterLocations.length}} starting point · {{campaignNearbyLocations.length}} nearby · {{campaignDistantLocations.length}} distant · {{campaignOutsideLocations.length}} outside the focus.</p></aside></section>
        {{/if}}

        {{#if campaignSteps.center.active}}
          <section class="ls-session-step"><div class="ls-step-kicker">Step 3 of 8</div><h2>Prepare the starting point deeply</h2><p>This is where the characters begin and where most early detail belongs.</p>{{#each campaignCenterLocations}}<article class="ls-region-location-card" data-campaign-entry-kind="locations" data-campaign-entry-id="{{id}}"><header><div><strong>{{name}}</strong><small>{{guidance}}</small></div><button type="button" data-action="removeCampaignMarker" data-id="{{id}}" title="Delete this map point"><i class="fa-solid fa-trash"></i></button></header><div class="ls-session-form"><label>What kind of place is this?<textarea data-campaign-field="description" rows="3">{{description}}</textarea></label><label>What is happening here now?<textarea data-campaign-field="currentSituation" rows="3">{{currentSituation}}</textarea></label><label>Why are the characters here?<textarea data-campaign-field="importance" rows="3">{{importance}}</textarea></label><label>Who matters here?<textarea data-campaign-field="people" rows="3">{{people}}</textarea></label><label>What help, services, or resources exist?<textarea data-campaign-field="services" rows="3">{{services}}</textarea></label><label>What visible problem begins the campaign?<textarea data-campaign-field="danger" rows="3">{{danger}}</textarea></label><label>What makes the characters leave and explore?<textarea data-campaign-field="reasonToLeave" rows="3">{{reasonToLeave}}</textarea></label><label>What changes if nobody acts?<textarea data-campaign-field="ignored" rows="3">{{ignored}}</textarea></label></div></article>{{else}}<div class="ls-warning">Choose a starting point on the previous step.</div>{{/each}}</section>
        {{/if}}

        {{#if campaignSteps.nearby.active}}
          <section class="ls-session-step"><div class="ls-step-kicker">Step 4 of 8</div><h2>Prepare nearby places enough to visit</h2><p>Nearby places need a playable reason to travel there and one useful opportunity or danger—not a complete gazetteer.</p><div class="ls-region-location-stack">{{#each campaignNearbyLocations}}<article class="ls-region-location-card" data-campaign-entry-kind="locations" data-campaign-entry-id="{{id}}"><header><div><strong>{{name}}</strong><small>{{guidance}}</small></div><span>{{distancePercent}} map-units from center</span><button type="button" data-action="removeCampaignMarker" data-id="{{id}}" title="Delete this map point"><i class="fa-solid fa-trash"></i></button></header><div class="ls-session-form"><label>Relationship with {{../campaignMap.startName}}<textarea data-campaign-field="relationship" rows="2">{{relationship}}</textarea></label><label>Why might the party travel here?<textarea data-campaign-field="reasonToVisit" rows="2">{{reasonToVisit}}</textarea></label><label>Useful person, resource, or opportunity<textarea data-campaign-field="opportunity" rows="2">{{opportunity}}</textarea></label><label>Danger or mystery<textarea data-campaign-field="danger" rows="2">{{danger}}</textarea></label><label>What clue or event points here?<textarea data-campaign-field="lead" rows="2">{{lead}}</textarea></label><label>Travel time and route<textarea data-campaign-field="travel" rows="2">{{travel}}</textarea></label></div></article>{{else}}<div class="ls-empty">No points fall in the nearby band. Enlarge the focus circle or add a nearby point.</div>{{/each}}</div></section>
        {{/if}}

        {{#if campaignSteps.distant.active}}
          <section class="ls-session-step"><div class="ls-step-kicker">Step 5 of 8</div><h2>Sketch the distant edge</h2><p>Do not overprepare. These points need enough identity to be mentioned naturally and expanded later.</p><div class="ls-region-location-stack">{{#each campaignDistantLocations}}<article class="ls-region-location-card" data-campaign-entry-kind="locations" data-campaign-entry-id="{{id}}"><header><div><strong>{{name}}</strong><small>{{guidance}}</small></div><button type="button" data-action="removeCampaignMarker" data-id="{{id}}" title="Delete this map point"><i class="fa-solid fa-trash"></i></button></header><div class="ls-session-form"><label>One-sentence identity<textarea data-campaign-field="description" rows="2">{{description}}</textarea></label><label>What is it known for?<textarea data-campaign-field="knownFor" rows="2">{{knownFor}}</textarea></label><label>One rumor or visible sign<textarea data-campaign-field="rumor" rows="2">{{rumor}}</textarea></label><label>Why might it matter later?<textarea data-campaign-field="futureUse" rows="2">{{futureUse}}</textarea></label></div></article>{{else}}<div class="ls-empty">No points fall in the distant band.</div>{{/each}}</div>{{#if campaignOutsideLocations.length}}<details><summary>Outside the focus · no preparation needed</summary><ul>{{#each campaignOutsideLocations}}<li>{{name}} <button type="button" data-action="removeCampaignMarker" data-id="{{id}}" title="Delete this map point"><i class="fa-solid fa-trash"></i></button></li>{{/each}}</ul></details>{{/if}}</section>
        {{/if}}

        {{#if campaignSteps.routes.active}}
          <section class="ls-session-step"><div class="ls-step-kicker">Step 6 of 8</div><h2>Connect the region</h2><p>Connections make geographical guidance coherent: roads, waterways, passes, trade, conflict, and shared mysteries.</p><div class="ls-campaign-entry-stack">{{#each campaignRoutes}}<article data-campaign-entry-kind="routes" data-campaign-entry-id="{{id}}"><header><strong>Connection {{number}}</strong><button data-action="removeCampaignEntry" data-kind="routes" data-id="{{id}}"><i class="fa-solid fa-trash"></i></button></header><div class="ls-session-form"><label>From<select data-campaign-field="fromId">{{#each fromOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label>To<select data-campaign-field="toId">{{#each toOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label>Connection type<select data-campaign-field="type">{{#each typeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label>Travel time<input data-campaign-field="travel" value="{{travel}}"></label><label>Memorable feature<textarea data-campaign-field="feature" rows="2">{{feature}}</textarea></label><label>Travel complication<textarea data-campaign-field="complication" rows="2">{{complication}}</textarea></label></div></article>{{/each}}</div><button data-action="addCampaignEntry" data-kind="routes"><i class="fa-solid fa-plus"></i> Add connection</button></section>
        {{/if}}

        {{#if campaignSteps.opening.active}}
          <section class="ls-session-step"><div class="ls-step-kicker">Step 7 of 8</div><h2>Create the opening campaign situation</h2><p>Use the geography you just prepared. Begin at {{campaignMap.startName}}, demonstrate a local problem, and provide at least two plausible directions into the nearby region.</p><div class="ls-session-form"><label class="wide">What immediate problem is visible at the starting point?<textarea name="campaignProblemWrong" rows="3">{{campaign.problem.wrong}}</textarea></label><label>Who or what is causing it?<textarea name="campaignProblemCause" rows="3">{{campaign.problem.cause}}</textarea></label><label>What happens if nobody acts?<textarea name="campaignProblemStakes" rows="3">{{campaign.problem.stakes}}</textarea></label><label>Why do the characters become involved?<textarea name="campaignProblemInvolvement" rows="3">{{campaign.problem.involvement}}</textarea></label><label>What sign shows the problem extends beyond the center?<textarea name="campaignProblemDistinction" rows="3">{{campaign.problem.distinction}}</textarea></label><label>What distant rumor suggests a wider world?<textarea name="campaignPremise" rows="3">{{campaign.premise}}</textarea></label></div><aside class="ls-campaign-guidance"><strong>Opening guidance</strong><p>Do not explain the entire campaign. Show the problem, make it matter locally, and let clues or events point toward two different nearby places. The party chooses which direction becomes the next detailed area.</p></aside></section>
        {{/if}}

        {{#if campaignSteps.review.active}}
          <section class="ls-session-step"><div class="ls-step-kicker">Step 8 of 8</div><h2>Review the starting region</h2><p>Lore Smith will generate a regional campaign Journal: the map and focus, a detailed starting point, playable nearby places, light distant gazetteer entries, travel connections, and the opening problem.</p>
          <div class="ls-region-review"><article><strong>{{campaignMap.startName}}</strong><span>Starting point prepared deeply</span></article><article><strong>{{campaignNearbyLocations.length}}</strong><span>Nearby places ready to visit</span></article><article><strong>{{campaignDistantLocations.length}}</strong><span>Distant places lightly sketched</span></article><article><strong>{{campaignRoutes.length}}</strong><span>Regional connections prepared</span></article></div>
          {{#if campaignValidation.length}}<div class="ls-warning"><strong>Required before creating the regional campaign:</strong>{{#each campaignValidation}}<div>{{this}}</div>{{/each}}</div>{{else}}<div class="ls-session-ready"><i class="fa-solid fa-circle-check"></i><span>The regional campaign Journal can be generated now.</span></div>{{/if}}{{#if campaignRecommendations.length}}<div class="ls-campaign-guidance"><strong>Preparation still recommended</strong><ul>{{#each campaignRecommendations}}<li>{{this}}</li>{{/each}}</ul></div>{{/if}}</section>
        {{/if}}

        <footer class="ls-session-navigation"><button data-action="previousCampaignStep" {{#unless canCampaignBack}}disabled{{/unless}}><i class="fa-solid fa-arrow-left"></i> Back</button><span>The draft saves automatically. Expand the region only when the campaign moves.</span>{{#if campaignSteps.review.active}}<button data-action="createCampaignJournal" {{#if campaignValidation.length}}disabled{{/if}}>{{#if campaignJournalAvailable}}Update{{else}}Create{{/if}} regional campaign <i class="fa-solid fa-book-sparkles"></i></button>{{else}}<button data-action="nextCampaignStep">Continue <i class="fa-solid fa-arrow-right"></i></button>{{/if}}</footer>
      </section>
    {{/if}}

    {{#if tabs.campaign}}
      <section class="ls-panel ls-campaign-panel">
        <header><div><span>Guided adventure-book authoring</span><h1>Campaign Builder</h1></div><div class="ls-header-actions"><button data-action="newCampaignBuild"><i class="fa-solid fa-rotate-left"></i> Start over</button><button data-action="openCampaignJournal" {{#unless campaignJournalAvailable}}disabled{{/unless}}><i class="fa-solid fa-book-open"></i> Open adventure</button></div></header>
        <p class="ls-lead">Write the campaign as a usable adventure book. The format and expected session count determine the writing plan used by later steps.</p>
        <div class="ls-session-progress ls-campaign-progress">{{#each campaignSteps}}<button data-action="goToCampaignStep" data-step="{{index}}" class="{{#if active}}active{{/if}}"><span>{{number}}</span>{{label}}</button>{{/each}}</div>
        {{#if campaignSteps.scope.active}}<section class="ls-session-step"><div class="ls-step-kicker">Step 1 of 8</div><h2>Choose the size of the adventure</h2><div class="ls-session-form"><label>Campaign name<input name="campaignName" value="{{campaign.name}}"></label><label>Campaign format<select name="campaignLength">{{#each campaignLengths}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label>Expected sessions<input type="number" name="campaignSessionCount" min="1" max="100" value="{{campaign.sessionCount}}"></label><label>Hours per session<input type="number" name="campaignSessionHours" min="1" max="12" value="{{campaign.sessionHours}}"></label><label>Starting level<input type="number" name="campaignStartingLevel" min="1" max="20" value="{{campaign.startingLevel}}"></label><label>Expected final level<input type="number" name="campaignFinalLevel" min="1" max="20" value="{{campaign.finalLevel}}"></label><label class="wide">Adventure summary<textarea name="campaignPremise" rows="4">{{campaign.premise}}</textarea></label></div><aside class="ls-campaign-guidance"><strong>{{campaignScope.label}} - {{campaignTargets.sessions}} sessions</strong><p>{{campaignGuidance.scope}}</p></aside></section>{{/if}}
        {{#if campaignSteps.conflict.active}}<section class="ls-session-step"><div class="ls-step-kicker">Step 2 of 8</div><h2>Background and central conflict</h2><div class="ls-session-form"><label class="wide">Background<textarea name="campaignBackground" rows="5">{{campaign.background}}</textarea></label><label class="wide">What is happening now?<textarea name="campaignProblemWrong" rows="3">{{campaign.problem.wrong}}</textarea></label><label>Who or what is causing it?<textarea name="campaignProblemCause" rows="3">{{campaign.problem.cause}}</textarea></label><label>What happens without intervention?<textarea name="campaignProblemStakes" rows="3">{{campaign.problem.stakes}}</textarea></label><label>Why do the characters become involved?<textarea name="campaignProblemInvolvement" rows="3">{{campaign.problem.involvement}}</textarea></label><label>What makes it distinctive?<textarea name="campaignProblemDistinction" rows="3">{{campaign.problem.distinction}}</textarea></label><label class="wide">Possible endings<textarea name="campaignProblemResolution" rows="3">{{campaign.problem.resolution}}</textarea></label><label class="wide">General character hooks<textarea name="campaignCharacterHooks" rows="3">{{campaign.characterHooks}}</textarea></label></div></section>{{/if}}
        {{#if campaignSteps.cast.active}}<section class="ls-session-step"><div class="ls-step-kicker">Step 3 of 8</div><h2>Cast and factions</h2><h3>Factions</h3><div class="ls-campaign-entry-stack">{{#each campaignFactions}}<article data-campaign-entry-kind="factions" data-campaign-entry-id="{{id}}"><header><strong>Faction {{number}}</strong><button data-action="removeCampaignEntry" data-kind="factions" data-id="{{id}}"><i class="fa-solid fa-trash"></i></button></header><div class="ls-session-form"><label>Name<input data-campaign-field="name" value="{{name}}"></label><label>Goal<textarea data-campaign-field="goal" rows="2">{{goal}}</textarea></label><label>Methods<textarea data-campaign-field="methods" rows="2">{{methods}}</textarea></label><label>Resources<textarea data-campaign-field="resources" rows="2">{{resources}}</textarea></label><label>Relationship with the party<textarea data-campaign-field="relationship" rows="2">{{relationship}}</textarea></label><label>What it does when ignored<textarea data-campaign-field="ignored" rows="2">{{ignored}}</textarea></label></div></article>{{/each}}</div><button data-action="addCampaignEntry" data-kind="factions"><i class="fa-solid fa-plus"></i> Add faction</button><h3>Important NPCs</h3><div class="ls-campaign-people">{{#each campaign.people}}<article data-campaign-person-id="{{id}}"><header><div><span>NPC {{number}}</span><small>{{suggestion}}</small></div><button data-action="removeCampaignEntry" data-kind="people" data-id="{{id}}"><i class="fa-solid fa-trash"></i></button></header><div class="ls-session-form"><label>Name<input name="campaignPersonName" value="{{name}}"></label><label>Description<input name="campaignPersonDescription" value="{{description}}"></label><label>What do they want?<textarea name="campaignPersonWants" rows="2">{{wants}}</textarea></label><label>What do they know?<textarea name="campaignPersonKnows" rows="2">{{knows}}</textarea></label><label class="wide">Secret or complication<textarea name="campaignPersonSecret" rows="2">{{secret}}</textarea></label></div></article>{{/each}}</div><button data-action="addCampaignEntry" data-kind="people"><i class="fa-solid fa-plus"></i> Add NPC</button></section>{{/if}}
        {{#if campaignSteps.locations.active}}<section class="ls-session-step"><div class="ls-step-kicker">Step 4 of 8</div><h2>Important locations</h2><div class="ls-campaign-entry-stack">{{#each campaignLocations}}<article data-campaign-entry-kind="locations" data-campaign-entry-id="{{id}}"><header><strong>Location {{number}}</strong><button data-action="removeCampaignEntry" data-kind="locations" data-id="{{id}}"><i class="fa-solid fa-trash"></i></button></header><div class="ls-campaign-location-body"><div class="ls-campaign-place-preview">{{#if image}}<img src="{{image}}">{{else}}<i class="fa-solid fa-mountain-sun"></i><span>No image selected</span>{{/if}}</div><div class="ls-session-form"><label>Name<input data-campaign-field="name" value="{{name}}"></label><label>Image<span class="ls-inline-control"><input data-campaign-field="image" value="{{image}}"><button type="button" data-action="browseCampaignLocationImage" data-id="{{id}}">Browse</button></span></label><label class="wide">Description<textarea data-campaign-field="description" rows="3">{{description}}</textarea></label><label>Purpose in the adventure<textarea data-campaign-field="importance" rows="2">{{importance}}</textarea></label><label>Secret or revelation<textarea data-campaign-field="secret" rows="2">{{secret}}</textarea></label></div></div></article>{{/each}}</div><button data-action="addCampaignEntry" data-kind="locations"><i class="fa-solid fa-plus"></i> Add location</button></section>{{/if}}
        {{#if campaignSteps.secrets.active}}<section class="ls-session-step"><div class="ls-step-kicker">Step 5 of 8</div><h2>Revelations and threats</h2><h3>Secrets and revelations</h3><div class="ls-campaign-entry-stack">{{#each campaignSecrets}}<article data-campaign-entry-kind="secrets" data-campaign-entry-id="{{id}}"><header><strong>Revelation {{number}}</strong><button data-action="removeCampaignEntry" data-kind="secrets" data-id="{{id}}"><i class="fa-solid fa-trash"></i></button></header><div class="ls-session-form"><label class="wide">What is true?<textarea data-campaign-field="secret" rows="2">{{secret}}</textarea></label><label>Clues<textarea data-campaign-field="clues" rows="3">{{clues}}</textarea></label><label>Who knows?<textarea data-campaign-field="knownBy" rows="3">{{knownBy}}</textarea></label></div></article>{{/each}}</div><button data-action="addCampaignEntry" data-kind="secrets">Add revelation</button><h3>Threats</h3><div class="ls-campaign-entry-stack">{{#each campaignThreats}}<article data-campaign-entry-kind="threats" data-campaign-entry-id="{{id}}"><header><strong>Threat {{number}}</strong><button data-action="removeCampaignEntry" data-kind="threats" data-id="{{id}}"><i class="fa-solid fa-trash"></i></button></header><div class="ls-session-form"><label>Name<input data-campaign-field="name" value="{{name}}"></label><label>Goal<textarea data-campaign-field="goal" rows="2">{{goal}}</textarea></label><label>Escalation<textarea data-campaign-field="escalation" rows="3">{{escalation}}</textarea></label><label>Consequences<textarea data-campaign-field="consequences" rows="3">{{consequences}}</textarea></label></div></article>{{/each}}</div><button data-action="addCampaignEntry" data-kind="threats">Add threat</button></section>{{/if}}
        {{#if campaignSteps.structure.active}}<section class="ls-session-step"><div class="ls-step-kicker">Step 6 of 8</div><h2>{{campaignScope.structureLabel}}</h2><div class="ls-campaign-entry-stack">{{#each campaignStructure}}<article data-campaign-entry-kind="structure" data-campaign-entry-id="{{id}}"><header><strong>{{../campaignScope.structureSingular}} {{number}}</strong><button data-action="removeCampaignEntry" data-kind="structure" data-id="{{id}}"><i class="fa-solid fa-trash"></i></button></header><div class="ls-session-form"><label>Name<input data-campaign-field="name" value="{{name}}"></label><label>{{../campaignScope.structureSummaryLabel}}<textarea data-campaign-field="summary" rows="3">{{summary}}</textarea></label><label class="wide">{{../campaignScope.structureOutcomeLabel}}<textarea data-campaign-field="outcome" rows="2">{{outcome}}</textarea></label></div></article>{{/each}}</div><button data-action="addCampaignEntry" data-kind="structure">Add {{campaignScope.structureSingular}}</button></section>{{/if}}
        {{#if campaignSteps.chapters.active}}<section class="ls-session-step"><div class="ls-step-kicker">Step 7 of 8</div>{{#if campaignStructured}}<h2>Write the {{campaignTargets.sessions}} session chapters</h2><div class="ls-campaign-chapters">{{#each campaignChapters}}<details data-campaign-entry-kind="chapters" data-campaign-entry-id="{{id}}"><summary><strong>Session {{number}}</strong><span>{{#if title}}{{title}}{{else}}Untitled chapter{{/if}}</span></summary><div class="ls-session-form"><label class="wide">Title<input data-campaign-field="title" value="{{title}}"></label><label>Purpose<textarea data-campaign-field="purpose" rows="2">{{purpose}}</textarea></label><label>Opening<textarea data-campaign-field="opening" rows="2">{{opening}}</textarea></label><label>GM information<textarea data-campaign-field="information" rows="3">{{information}}</textarea></label><label>Locations<textarea data-campaign-field="locations" rows="3">{{locations}}</textarea></label><label>NPCs and factions<textarea data-campaign-field="npcs" rows="3">{{npcs}}</textarea></label><label>Likely scenes<textarea data-campaign-field="scenes" rows="3">{{scenes}}</textarea></label><label>Clues<textarea data-campaign-field="revelations" rows="3">{{revelations}}</textarea></label><label>Encounters<textarea data-campaign-field="encounters" rows="3">{{encounters}}</textarea></label><label>Rewards<textarea data-campaign-field="rewards" rows="2">{{rewards}}</textarea></label><label>Choices<textarea data-campaign-field="choices" rows="3">{{choices}}</textarea></label><label>Consequences<textarea data-campaign-field="consequences" rows="3">{{consequences}}</textarea></label><label class="wide">Transition<textarea data-campaign-field="transition" rows="2">{{transition}}</textarea></label></div></details>{{/each}}</div>{{else}}<h2>Sandbox play kit</h2><div class="ls-campaign-entry-stack">{{#each campaignRumors}}<article data-campaign-entry-kind="rumors" data-campaign-entry-id="{{id}}"><header><strong>Rumor {{number}}</strong></header><div class="ls-session-form"><label>What people say<textarea data-campaign-field="text" rows="2">{{text}}</textarea></label><label>Truth<textarea data-campaign-field="truth" rows="2">{{truth}}</textarea></label></div></article>{{/each}}{{#each campaignWorldEvents}}<article data-campaign-entry-kind="worldEvents" data-campaign-entry-id="{{id}}"><header><strong>World event {{number}}</strong></header><div class="ls-session-form"><label>Trigger<input data-campaign-field="trigger" value="{{trigger}}"></label><label>Event<textarea data-campaign-field="event" rows="2">{{event}}</textarea></label><label class="wide">Consequence<textarea data-campaign-field="consequence" rows="2">{{consequence}}</textarea></label></div></article>{{/each}}</div>{{/if}}</section>{{/if}}
        {{#if campaignSteps.review.active}}<section class="ls-session-step"><div class="ls-step-kicker">Step 8 of 8</div><h2>Progression and review</h2><div class="ls-session-form"><label>Leveling<select name="campaignLeveling">{{#each campaignLevelingOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label>Important treasure<textarea name="campaignProgressionTreasure" rows="2">{{campaign.progression.treasure}}</textarea></label><label>Narrative rewards<textarea name="campaignProgressionNarrative" rows="2">{{campaign.progression.narrative}}</textarea></label><label>Reputation and holdings<textarea name="campaignProgressionReputation" rows="2">{{campaign.progression.reputation}}</textarea></label><label class="wide">Campaign-specific options<textarea name="campaignProgressionOptions" rows="2">{{campaign.progression.options}}</textarea></label><label>Rules conventions<textarea name="campaignConsistencyRules" rows="2">{{campaign.consistency.rules}}</textarea></label><label>Timeline<textarea name="campaignConsistencyTimeline" rows="2">{{campaign.consistency.timeline}}</textarea></label><label class="wide">Travel assumptions<textarea name="campaignConsistencyTravel" rows="2">{{campaign.consistency.travel}}</textarea></label></div>{{#if campaignValidation.length}}<div class="ls-warning"><strong>Required before creating the adventure:</strong>{{#each campaignValidation}}<div>{{this}}</div>{{/each}}</div>{{else}}<div class="ls-session-ready"><i class="fa-solid fa-circle-check"></i><span>The adventure book is ready.</span></div>{{/if}}</section>{{/if}}
        <footer class="ls-session-navigation"><button data-action="previousCampaignStep" {{#unless canCampaignBack}}disabled{{/unless}}><i class="fa-solid fa-arrow-left"></i> Back</button><span>The Campaign Builder and Campaign Map Builder keep separate drafts.</span>{{#if campaignSteps.review.active}}<button data-action="createCampaignJournal" {{#if campaignValidation.length}}disabled{{/if}}>{{#if campaignJournalAvailable}}Update{{else}}Create{{/if}} adventure book</button>{{else}}<button data-action="nextCampaignStep">Continue <i class="fa-solid fa-arrow-right"></i></button>{{/if}}</footer>
      </section>
    {{/if}}

    {{#if tabs.session}}
      <section class="ls-panel ls-session-panel">
        <header><div><span>Guided next-session preparation</span><h1>Session Prep</h1></div><div class="ls-header-actions"><button data-action="newSessionPrep"><i class="fa-solid fa-rotate-left"></i> Start over</button><button data-action="openLastSessionJournal" {{#unless lastSessionJournalId}}disabled{{/unless}}><i class="fa-solid fa-book-open"></i> Open last session</button></div></header>
        <p class="ls-lead">Answer a few focused questions. Lore Smith turns them into a ready-to-run Foundry Journal, with every important place, person, scene, and secret on its own page.</p>
        <div class="ls-session-progress" aria-label="Session prep progress">
          {{#each sessionSteps}}<button data-action="goToSessionStep" data-step="{{index}}" class="{{#if active}}active{{/if}}"><span>{{number}}</span>{{label}}</button>{{/each}}
        </div>

        {{#if sessionSteps.goal.active}}
          <section class="ls-session-step"><div class="ls-step-kicker">Step 1 of 6</div><h2>Choose the session's main goal</h2><p>Write the one thing the players should be able to pursue, discover, prevent, or decide tonight. It gives every later scene a purpose.</p>
            <div class="ls-session-form"><label>Session title<input name="sessionTitle" value="{{sessionPrep.title}}" placeholder="Session 12 — Smoke over Otari"></label><label class="wide">Main goal<textarea name="sessionGoal" rows="4" placeholder="The heroes discover who is sabotaging the lighthouse before the harbour festival begins.">{{sessionPrep.goal}}</textarea></label><label>Opening situation<textarea name="sessionOpening" rows="3" placeholder="Where the session begins and what immediately demands attention.">{{sessionPrep.opening}}</textarea></label><label>Likely ending or cliffhanger<textarea name="sessionEnding" rows="3" placeholder="A reveal, choice, fight, or question to leave the table with.">{{sessionPrep.ending}}</textarea></label></div>
          </section>
        {{/if}}

        {{#if sessionSteps.locations.active}}
          <section class="ls-session-step"><div class="ls-step-kicker">Step 2 of 6</div><h2>Prepare at least two important places</h2><p>Give each place a quick image and sensory cues. Small details make a place easy to run, and you can add more places when needed.</p>
            <div class="ls-location-stack">{{#each sessionPrep.locations}}<article class="ls-location-card" data-location-id="{{id}}"><header><div><span>Important place {{number}}</span><strong>{{#if name}}{{name}}{{else}}Unnamed place{{/if}}</strong></div>{{#if canRemove}}<button class="danger" data-action="removeLocation" data-id="{{id}}" data-tooltip="Remove location"><i class="fa-solid fa-trash"></i></button>{{/if}}</header><div class="ls-session-form">
              <label>Place name<input name="locationName" value="{{name}}" placeholder="The flooded bell tower"></label><label>Image path or URL<span class="ls-inline-control"><input name="locationImage" value="{{image}}" placeholder="Choose an image"><button data-action="browseLocationImage" data-id="{{id}}" type="button">Browse</button></span></label>
              <label class="wide">What makes this place matter?<textarea name="locationPurpose" rows="2" placeholder="A clue, confrontation, resource, refuge, or obstacle.">{{purpose}}</textarea></label>
              <div class="ls-sense-grid wide"><label><i class="fa-solid fa-eye"></i> Sight<input name="locationSight" value="{{sight}}" placeholder="Light, colours, movement, landmarks"></label><label><i class="fa-solid fa-ear-listen"></i> Hearing<input name="locationHearing" value="{{hearing}}" placeholder="Voices, machinery, weather, silence"></label><label><i class="fa-solid fa-wind"></i> Smell<input name="locationSmell" value="{{smell}}" placeholder="Smoke, rain, salt, incense"></label><label><i class="fa-solid fa-hand"></i> Touch<input name="locationTouch" value="{{touch}}" placeholder="Heat, dampness, rough stone, wind"></label><label><i class="fa-solid fa-utensils"></i> Taste<input name="locationTaste" value="{{taste}}" placeholder="Ash in the air, brine, copper"></label></div>
            </div></article>{{/each}}</div><button data-action="addLocation"><i class="fa-solid fa-plus"></i> Add another place</button>
          </section>
        {{/if}}

        {{#if sessionSteps.people.active}}
          <section class="ls-session-step"><div class="ls-step-kicker">Step 3 of 6</div><h2>People, factions, hazards, and encounters</h2><p>Keep this short and table-ready. Foundry actors dropped below remain clickable in the generated Journal.</p>
            <div class="ls-npc-stack">{{#each sessionPrep.npcs}}<article class="ls-session-npc-card" data-session-npc-id="{{id}}">
              <header><div><span>Important NPC {{number}}</span><strong>{{#if name}}{{name}}{{else}}Unnamed NPC{{/if}}</strong></div><button class="danger" data-action="removeSessionNpc" data-id="{{id}}" data-tooltip="Remove NPC"><i class="fa-solid fa-trash"></i></button></header>
              <div class="ls-session-npc-body"><div class="ls-session-npc-portrait">{{#if image}}<img src="{{image}}" alt="{{name}}">{{else}}<i class="fa-solid fa-user"></i>{{/if}}</div><div class="ls-session-form">
                <label>NPC name<input name="npcName" value="{{name}}" placeholder="Captain Vell"></label><label>Portrait<span class="ls-inline-control"><input name="npcImage" value="{{image}}" placeholder="Choose an NPC image"><button data-action="browseSessionNpcImage" data-id="{{id}}" type="button">Browse</button></span></label>
                <label>Role in this session<textarea name="npcRole" rows="2" placeholder="Helpful harbour captain and reluctant quest giver.">{{role}}</textarea></label><label>What do they want?<textarea name="npcMotivation" rows="2" placeholder="Stop the sabotage without causing public panic.">{{motivation}}</textarea></label>
                <label class="wide">Secret or complication<textarea name="npcSecret" rows="2" placeholder="They recognized the culprit but are protecting someone close to them.">{{secret}}</textarea></label>
              </div></div>
            </article>{{else}}<div class="ls-empty">No important NPCs prepared yet.</div>{{/each}}</div>
            <button data-action="addSessionNpc"><i class="fa-solid fa-user-plus"></i> Add NPC</button>
            <section class="ls-structured-section"><header><div><strong>Other people and factions</strong><small>Name and basic description</small></div><button data-action="addPeopleEntry"><i class="fa-solid fa-plus"></i></button></header><div class="ls-repeat-list">{{#each peopleEntries}}<div class="ls-pair-row" data-people-entry-id="{{id}}"><input name="peopleName" value="{{name}}" placeholder="Person or faction name"><input name="peopleDescription" value="{{description}}" placeholder="Basic description, goal, or relationship"><button class="danger" data-action="removePeopleEntry" data-id="{{id}}"><i class="fa-solid fa-trash"></i></button></div>{{/each}}</div></section>
            <section class="ls-structured-section"><header><div><strong>Hazards</strong><small>Drag PF2e Hazard actors here.</small></div></header><div class="ls-document-drop" data-session-drop-kind="hazard"><i class="fa-solid fa-triangle-exclamation"></i><span>Drop hazard actors here</span></div><div class="ls-reference-list">{{#each hazards}}<div><img src="{{img}}"><span>{{name}}<small>{{type}}</small></span><button data-action="removeSessionReference" data-kind="hazard" data-id="{{id}}"><i class="fa-solid fa-xmark"></i></button></div>{{/each}}</div></section>
            <section class="ls-structured-section"><header><div><strong>Encounters</strong><small>Choose social or combat.</small></div><button data-action="addSessionEncounter"><i class="fa-solid fa-plus"></i></button></header><div class="ls-encounter-prep-list">{{#each encounterEntries}}<article data-session-encounter-id="{{id}}"><header><strong>Encounter {{number}}</strong><select name="encounterType"><option value="social" {{#if social}}selected{{/if}}>Social encounter</option><option value="combat" {{#if combat}}selected{{/if}}>Combat encounter</option></select><button class="danger" data-action="removeSessionEncounter" data-id="{{id}}"><i class="fa-solid fa-trash"></i></button></header>{{#if combat}}<div class="ls-document-drop" data-session-drop-kind="encounter" data-parent-id="{{id}}"><i class="fa-solid fa-swords"></i><span>Drop enemy actors here</span></div><div class="ls-reference-list">{{#each actors}}<div><img src="{{img}}"><span>{{name}}<small>{{type}}</small></span><button data-action="removeSessionReference" data-kind="encounter" data-parent-id="{{../id}}" data-id="{{id}}"><i class="fa-solid fa-xmark"></i></button></div>{{/each}}</div>{{/if}}<textarea name="encounterDescription" rows="3" placeholder="{{#if social}}People, goals, leverage, and attitude changes.{{else}}Terrain, tactics, reinforcements, or surrender conditions.{{/if}}">{{description}}</textarea></article>{{/each}}</div></section>
          </section>
        {{/if}}

        {{#if sessionSteps.music.active}}
          <section class="ls-session-step"><div class="ls-step-kicker">Step 4 of 6</div><h2>Music and atmosphere</h2><p>Prepare only the cues that matter. Choose an existing Foundry Playlist or a direct audio file, then note the moment and feeling it should support.</p>
            {{#unless hasFoundryPlaylists}}<div class="ls-warning"><strong>No Foundry Playlist exists yet.</strong><div>Lore Smith will create a session Playlist automatically and add your audio cues to it.</div></div>{{/unless}}
            <div class="ls-music-stack">{{#each sessionPrep.musicCues}}<article class="ls-music-card" data-session-music-id="{{id}}">
              <header><div><span>Music cue {{number}}</span><strong>{{#if name}}{{name}}{{else}}{{moment}}{{/if}}</strong></div><button class="danger" data-action="removeMusicCue" data-id="{{id}}" data-tooltip="Remove music cue"><i class="fa-solid fa-trash"></i></button></header>
              <div class="ls-music-body"><div class="ls-music-icon"><i class="fa-solid fa-music"></i></div><div class="ls-session-form">
                <label>Cue name<input name="musicName" value="{{name}}" placeholder="The lighthouse awakens"></label><label>Moment<select name="musicMoment">{{#each momentOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                <label>Mood and purpose<input name="musicMood" value="{{mood}}" placeholder="Ancient wonder turning into unease"></label><label>Foundry Playlist<select name="musicPlaylist">{{#each playlistOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label class="wide">Song from that Playlist<select name="musicSound">{{#each trackOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                <label class="wide">Audio track <span class="ls-inline-control"><input name="musicAudio" value="{{audio}}" placeholder="This file will be added to the selected Playlist"><button data-action="browseMusicAudio" data-id="{{id}}" type="button">Browse</button></span></label>
                <label class="wide">When should it start, change, or stop?<textarea name="musicNotes" rows="3" placeholder="Begin quietly when the lens starts turning. Stop on the first attack, then switch to the combat Playlist.">{{notes}}</textarea></label>
              </div></div>
            </article>{{else}}<div class="ls-empty">No music cues prepared. Deliberate silence is also a valid choice.</div>{{/each}}</div>
            <button data-action="addMusicCue"><i class="fa-solid fa-plus"></i> Add music cue</button>
          </section>
        {{/if}}

        {{#if sessionSteps.scenes.active}}
          <section class="ls-session-step"><div class="ls-step-kicker">Step 5 of 6</div><h2>Scenes, clues, and rewards</h2><p>Prepare situations rather than a rigid script. Give the players several clues and something meaningful to gain or lose.</p>
            <div class="ls-scenes-grid"><section class="ls-structured-section"><header><strong>Likely scenes</strong><button data-action="addSessionTextEntry" data-kind="scene"><i class="fa-solid fa-plus"></i></button></header>{{#each sceneEntries}}<div class="ls-text-row" data-session-text-kind="scene" data-session-text-id="{{id}}"><textarea rows="2" placeholder="A situation likely to happen at the table.">{{text}}</textarea><button data-action="removeSessionTextEntry" data-kind="scene" data-id="{{id}}"><i class="fa-solid fa-trash"></i></button></div>{{/each}}</section><section class="ls-structured-section"><header><strong>Clues</strong><button data-action="addSessionTextEntry" data-kind="clue"><i class="fa-solid fa-plus"></i></button></header>{{#each clueEntries}}<div class="ls-text-row" data-session-text-kind="clue" data-session-text-id="{{id}}"><textarea rows="2" placeholder="A clue and what it points toward.">{{text}}</textarea><button data-action="removeSessionTextEntry" data-kind="clue" data-id="{{id}}"><i class="fa-solid fa-trash"></i></button></div>{{/each}}</section><section class="ls-structured-section"><header><strong>Rewards</strong><small>Drag PF2e Items here.</small></header><div class="ls-document-drop" data-session-drop-kind="reward"><i class="fa-solid fa-gift"></i><span>Drop reward items here</span></div><div class="ls-reference-list">{{#each rewardItems}}<div><img src="{{img}}"><span>{{name}}<small>{{type}}</small></span><button data-action="removeSessionReference" data-kind="reward" data-id="{{id}}"><i class="fa-solid fa-xmark"></i></button></div>{{/each}}</div></section><section class="ls-structured-section"><header><strong>Consequences</strong><button data-action="addSessionTextEntry" data-kind="consequence"><i class="fa-solid fa-plus"></i></button></header>{{#each consequenceEntries}}<div class="ls-text-row" data-session-text-kind="consequence" data-session-text-id="{{id}}"><textarea rows="2" placeholder="What follows from choices or failures?">{{text}}</textarea><button data-action="removeSessionTextEntry" data-kind="consequence" data-id="{{id}}"><i class="fa-solid fa-trash"></i></button></div>{{/each}}</section><section class="ls-structured-section"><header><strong>Changes</strong><button data-action="addSessionTextEntry" data-kind="change"><i class="fa-solid fa-plus"></i></button></header>{{#each changeEntries}}<div class="ls-text-row" data-session-text-kind="change" data-session-text-id="{{id}}"><textarea rows="2" placeholder="What changes in the world or relationships?">{{text}}</textarea><button data-action="removeSessionTextEntry" data-kind="change" data-id="{{id}}"><i class="fa-solid fa-trash"></i></button></div>{{/each}}</section></div>
          </section>
        {{/if}}

        {{#if sessionSteps.review.active}}
          <section class="ls-session-step"><div class="ls-step-kicker">Step 6 of 6</div><h2>Final GM reminders</h2><p>Add anything you want visible only to you, then create the session journal. You can edit every generated page normally afterward.</p>
            <div class="ls-session-form"><label class="wide">GM reminders and secrets<textarea name="sessionReminders" rows="8" placeholder="The saboteur is actually working for the mayor. Let the players learn this only if they decode the ledger or question Mira.">{{sessionPrep.reminders}}</textarea></label></div>
            {{#if sessionValidation.length}}<div class="ls-warning"><strong>Before creating the journal:</strong>{{#each sessionValidation}}<div>{{this}}</div>{{/each}}</div>{{else}}<div class="ls-session-ready"><i class="fa-solid fa-circle-check"></i><span>Your session packet is ready to create.</span></div>{{/if}}
          </section>
        {{/if}}

        <footer class="ls-session-navigation"><button data-action="previousSessionStep" {{#unless canSessionBack}}disabled{{/unless}}><i class="fa-solid fa-arrow-left"></i> Back</button><span>Everything is saved in this wizard until you create the Journal.</span>{{#if sessionSteps.review.active}}<button data-action="createSessionJournal" {{#if sessionValidation.length}}disabled{{/if}}>Create session Journal <i class="fa-solid fa-book-sparkles"></i></button>{{else}}<button data-action="nextSessionStep">Continue <i class="fa-solid fa-arrow-right"></i></button>{{/if}}</footer>
      </section>
    {{/if}}

    {{#if tabs.loot}}
      <section class="ls-panel ls-loot-panel">
        <header><div><span>PF2e native treasure workspace</span><h1>Loot & Treasure Generator</h1></div><button data-action="clearLoot"><i class="fa-solid fa-broom"></i> Clear</button></header>
        <p class="ls-lead">Choose exactly what the reward should do. Required mechanics must match, preferred mechanics improve ranking, and excluded mechanics are rejected. Every result explains why it was selected.</p>
        <div class="ls-loot-controls">
          <label>Minimum level<input type="number" name="lootMinLevel" min="0" max="30" value="{{lootMinLevel}}"></label>
          <label>Maximum level<input type="number" name="lootMaxLevel" min="0" max="30" value="{{lootMaxLevel}}"></label>
          <label>Number of results<input type="number" name="lootCount" min="1" max="100" value="{{lootCount}}"></label>
          <fieldset><legend>Treasure sources</legend><label><input type="checkbox" name="lootPermanent" {{#if lootSources.permanent}}checked{{/if}}> Permanent items</label><label><input type="checkbox" name="lootConsumable" {{#if lootSources.consumable}}checked{{/if}}> Consumables</label><label><input type="checkbox" name="lootGems" {{#if lootSources.gems}}checked{{/if}}> Precious stones</label><label><input type="checkbox" name="lootArt" {{#if lootSources.art}}checked{{/if}}> Art objects</label></fieldset>
          <fieldset><legend>Item rarity</legend><label><input type="checkbox" name="lootRarityCommon" {{#if lootRarities.common}}checked{{/if}}> Common</label><label><input type="checkbox" name="lootRarityUncommon" {{#if lootRarities.uncommon}}checked{{/if}}> Uncommon</label><label><input type="checkbox" name="lootRarityRare" {{#if lootRarities.rare}}checked{{/if}}> Rare</label><label><input type="checkbox" name="lootRarityUnique" {{#if lootRarities.unique}}checked{{/if}}> Unique</label></fieldset>
          <section class="ls-loot-filter-builder">
            <header><div><strong>Mechanical filters</strong><small>Use Required for necessities, Preferred for useful extras, and Excluded for effects you do not want.</small></div><button type="button" data-action="addLootFilter"><i class="fa-solid fa-plus"></i> Add filter</button></header>
            <div class="ls-loot-filter-list">
              {{#each lootFilters}}
                <div class="ls-loot-filter-row" data-loot-filter-id="{{id}}">
                  <label>Rule<select name="lootFilterMode">{{#each modes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                  <label>Mechanic<select name="lootFilterMechanic">{{#each mechanics}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                  {{#if hasDetails}}<label>{{detailLabel}}<select name="lootFilterDetail"><option value="">Any</option>{{#each details}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{else}}<div class="ls-loot-no-detail"><span>No extra detail needed</span></div>{{/if}}
                  <button type="button" data-action="removeLootFilter" data-tooltip="Remove filter"><i class="fa-solid fa-trash"></i></button>
                </div>
              {{else}}<div class="ls-loot-filter-empty">No mechanical filters: results will only use source, rarity, and level.</div>{{/each}}
            </div>
            <div class="ls-loot-match-options"><label>Required-filter logic<select name="lootMatchMode">{{#each lootMatchModes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label class="ls-check-row"><input type="checkbox" name="lootFlexible" {{#if lootFlexible}}checked{{/if}}> Include description-assisted matches</label></div>
            <p>Strict matches use PF2e item types, traits, and rule elements. Description-assisted matching also recognizes mechanics stated in official rules text. Gem and art-object tables ignore item-mechanic filters.</p>
          </section>
          <button data-action="generateLoot"><i class="fa-solid fa-dice"></i> Generate treasure</button>
        </div>
        {{#if lootStatus}}<div class="ls-loot-status">{{lootStatus}}</div>{{/if}}
        <div class="ls-loot-results">{{#each lootResults}}<article><img src="{{img}}"><div><strong>{{name}}</strong><span>Level {{level}} · {{type}} · {{source}}</span><small>{{reason}}</small></div>{{#if uuid}}<button data-action="openLootDocument" data-uuid="{{uuid}}" data-tooltip="Open item"><i class="fa-solid fa-up-right-from-square"></i></button><button data-action="addLootToRewards" data-id="{{id}}" data-tooltip="Add to Session Prep rewards"><i class="fa-solid fa-gift"></i></button>{{/if}}</article>{{else}}<div class="ls-empty">Choose filters and generate explainable PF2e rewards.</div>{{/each}}</div>
      </section>
    {{/if}}

    {{#if tabs.notes}}
      <section class="ls-panel">
        <header><div><span>Native Foundry Journal pages</span><h1>{{notebookName}}</h1></div><div class="ls-header-actions"><button data-action="openNotebook"><i class="fa-solid fa-book-open"></i> Open Foundry Journal</button><button data-action="createNote"><i class="fa-solid fa-plus"></i> New page</button></div></header>
        <p class="ls-lead">Every note is a page inside this single Journal. Rename the Journal and use Foundry's complete formatting and image tools from its native sheet. Type <strong>[[Page Name]]</strong> to link pages.</p>
        <div class="ls-note-workspace">
          <aside class="ls-note-list">
            {{#each notes}}
              <button data-action="openNote" data-id="{{id}}" class="{{#if active}}active{{/if}}">
                <i class="fa-solid fa-file-lines"></i><span>{{name}}</span>
              </button>
            {{else}}
              <div class="ls-empty">No pages yet. Select <strong>New page</strong> to begin.</div>
            {{/each}}
          </aside>
          <section class="ls-note-paper">
            {{#if activeNote}}
              <input class="ls-note-title" data-role="note-title" value="{{activeNote.name}}" aria-label="Note title">
              <div class="ls-note-editor" data-role="note-editor" contenteditable="true" spellcheck="true">{{{activeNote.content}}}</div>
              <footer><span><i class="fa-solid fa-circle-check"></i> Saved automatically</span><span>Double-click a wiki link to edit its <strong>[[name]]</strong>.</span></footer>
            {{else}}
              <div class="ls-empty ls-note-empty"><i class="fa-solid fa-feather-pointed"></i><strong>Your chronicle is empty.</strong><span>Create a page to start writing.</span></div>
            {{/if}}
          </section>
        </div>
      </section>
    {{/if}}

    {{#if tabs.creatures}}
      <section class="ls-panel">
        <header><div><span>PF2e Actor Workshop</span><h1>Creature Builder</h1></div><button data-action="blankCreature"><i class="fa-solid fa-plus"></i> Blank NPC</button></header>
        <p class="ls-lead">Search installed PF2e Actor compendia, create an editable world copy, and continue editing it on the native PF2e NPC sheet.</p>
        <div class="ls-search-row"><input name="creatureSearch" value="{{creatureSearch}}" placeholder="Search creature names…"><button data-action="searchCreatures">Search compendia</button></div>
        <div class="ls-card-list">
          {{#each creatureResults}}
            <article class="ls-list-card">
              <img src="{{img}}">
              <div><strong>{{name}}</strong><small>Level {{level}} · {{packLabel}}</small></div>
              <button data-action="cloneCreature" data-uuid="{{uuid}}">Create copy</button>
            </article>
          {{else}}
            <div class="ls-empty">Search to browse creatures installed with the PF2e system.</div>
          {{/each}}
        </div>
      </section>
    {{/if}}

    {{#if tabs.items}}
      <section class="ls-panel">
        <header><div><span>PF2e Item Workshop</span><h1>Item Builder</h1></div><button data-action="blankItem"><i class="fa-solid fa-plus"></i> Blank item</button></header>
        <p class="ls-lead">Search every installed PF2e Item compendium. Copies keep native traits, usage, price, activation, rules, and system automation.</p>
        <div class="ls-search-row"><input name="itemSearch" value="{{itemSearch}}" placeholder="Search equipment, spells, feats, or effects…"><select name="itemType"><option value="">All item types</option>{{#each itemTypes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select><button data-action="searchItems">Search compendia</button></div>
        <div class="ls-card-list">
          {{#each itemResults}}
            <article class="ls-list-card">
              <img src="{{img}}">
              <div><strong>{{name}}</strong><small>{{type}} · Level {{level}} · {{packLabel}}</small></div>
              <button data-action="cloneItem" data-uuid="{{uuid}}">Create copy</button>
            </article>
          {{else}}
            <div class="ls-empty">Search to browse native PF2e items, spells, feats, and effects.</div>
          {{/each}}
        </div>
      </section>
    {{/if}}

    {{#if tabs.encounter}}
      <section class="ls-panel">
        <header><div><span>Foundry Scene + PF2e Actors</span><h1>Encounter Lab</h1></div><button data-action="refreshEncounter"><i class="fa-solid fa-rotate"></i> Refresh scene</button></header>
        <p class="ls-lead">Choose tokens from the active scene. Lore Smith uses their prepared PF2e statistics; live replay uses the real canvas, grid, walls, tokens, and Chat log.</p>
        {{#unless sceneReady}}<div class="ls-warning">Open a Scene with tokens before building an encounter.</div>{{/unless}}
        <div class="ls-encounter-grid">
          <section><h2>Characters</h2>{{#each sceneTokens}}{{#if isCharacter}}<label class="ls-token-choice"><input type="checkbox" name="partyToken" value="{{id}}" {{#if party}}checked{{/if}}><img src="{{img}}"><span>{{name}}<small>Level {{level}} · HP {{hp}} · AC {{ac}}</small></span></label>{{/if}}{{/each}}</section>
          <section><h2>Opposition</h2>{{#each sceneTokens}}{{#unless isCharacter}}<label class="ls-token-choice"><input type="checkbox" name="enemyToken" value="{{id}}" {{#if enemy}}checked{{/if}}><img src="{{img}}"><span>{{name}}<small>Level {{level}} · HP {{hp}} · AC {{ac}}</small></span></label>{{/unless}}{{/each}}</section>
        </div>
        <div class="ls-run-row"><span class="ls-iteration-setting"><strong>{{iterations}} iterations</strong><small>Change this in Module Settings → Lore Smith.</small></span><button data-action="runEstimate"><i class="fa-solid fa-chart-line"></i> Run estimate</button><button class="live" data-action="runLive"><i class="fa-solid fa-play"></i> Watch live combat</button></div>
        {{#if result}}
          <div class="ls-results">
            <article><span>Character victory</span><strong>{{result.winRate}}%</strong><small>{{result.wins}}/{{result.iterations}} combats</small></article>
            <article><span>PF2e XP difficulty</span><strong>{{result.difficulty}}</strong><small>{{result.xp}} adjusted XP · party level {{result.partyLevel}}</small></article>
            <article><span>Average duration</span><strong>{{result.averageRounds}}</strong><small>rounds</small></article>
          </div>
          <details class="ls-log" open><summary>Combat log · sample iteration</summary>{{#each result.log}}<p class="{{kind}}">{{text}}</p>{{/each}}</details>
        {{/if}}
      </section>
    {{/if}}
  </main>
</div>
