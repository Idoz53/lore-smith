<section class="ls-builder ls-item-workshop">
  <header class="ls-builder-heading">
    <div><span>PF2e native item</span><h1>Item Builder</h1><p>Step {{stepNumber}} of 6</p></div>
    <div class="ls-builder-actor"><img src="{{item.img}}"><strong>{{item.name}}</strong><small>{{item.typeLabel}}</small></div>
  </header>

  <div class="ls-step-track six">
    <button type="button" data-action="goToStep" data-step="0" class="{{#if steps.source}}active{{/if}}">1. Starting point</button>
    <button type="button" data-action="goToStep" data-step="1" class="{{#if steps.basics}}active{{/if}}">2. Identity</button>
    <button type="button" data-action="goToStep" data-step="2" class="{{#if steps.mechanics}}active{{/if}}">3. {{item.typeLabel}}</button>
    <button type="button" data-action="goToStep" data-step="3" class="{{#if steps.activation}}active{{/if}}">4. Activation</button>
    <button type="button" data-action="goToStep" data-step="4" class="{{#if steps.automation}}active{{/if}}">5. Effects</button>
    <button type="button" data-action="goToStep" data-step="5" class="{{#if steps.review}}active{{/if}}">6. Review</button>
  </div>

  <main class="ls-builder-body">
    {{#if steps.source}}
      <section class="ls-builder-step">
        <h2>Choose a starting point</h2>
        <p>Copy an installed PF2e {{item.typeLabel}} or keep this native item blank. Copied rules, runes, subitems, and automation are preserved.</p>
        <div class="ls-builder-filters">
          <input name="sourceQuery" value="{{query}}" placeholder="Search name, trait, or rules text">
          <select name="sourceLevel"><option value="">All levels</option>{{#each levelFilters}}<option value="{{value}}" {{#if selected}}selected{{/if}}>Level {{label}}</option>{{/each}}</select>
          <select name="sourceTrait"><option value="">All traits</option>{{#each itemTraitOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
          <button data-action="searchSource"><i class="fa-solid fa-filter"></i> Filter</button>
          <button class="secondary" data-action="useCurrent"><i class="fa-regular fa-file"></i> Start blank</button>
        </div>
        <div class="ls-browser-summary"><span>{{sourceCount}} matching native items</span><span>Page {{sourcePageLabel}}</span></div>
        <div class="ls-source-browser">
          <div class="ls-builder-results compact tall">
            {{#each results}}
              <article data-action="previewSource" data-uuid="{{uuid}}"><img src="{{img}}"><div><strong>{{name}}</strong><small>Level {{level}} &middot; {{traits}} &middot; {{pack}}</small></div><button data-action="useSource" data-uuid="{{uuid}}">Use as base</button></article>
            {{else}}<div class="ls-builder-empty">No installed PF2e item matches these filters.</div>{{/each}}
          </div>
          <aside class="ls-source-preview">
            {{#if sourcePreview}}
              <header><img src="{{sourcePreview.img}}"><div><h3>{{sourcePreview.name}}</h3><span>Level {{sourcePreview.level}} {{sourcePreview.type}}</span></div></header>
              <div class="ls-preview-traits">{{#each sourcePreview.traits}}<span>{{this}}</span>{{/each}}</div>
              <dl><div><dt>Usage</dt><dd>{{sourcePreview.usage}}</dd></div><div><dt>Bulk</dt><dd>{{sourcePreview.bulk}}</dd></div><div><dt>Price</dt><dd>{{sourcePreview.price}}</dd></div></dl>
              <div class="ls-preview-description">{{{sourcePreview.description}}}</div>
              <button data-action="useSource" data-uuid="{{sourcePreview.uuid}}">Use {{sourcePreview.name}} as base</button>
            {{else}}<div class="ls-preview-empty"><i class="fa-solid fa-eye"></i><strong>Select an item</strong><span>Preview it here before copying it.</span></div>{{/if}}
          </aside>
        </div>
        <div class="ls-browser-pages"><button data-action="previousSources" {{#unless hasPreviousSources}}disabled{{/unless}}><i class="fa-solid fa-arrow-left"></i> Previous</button><span>Page {{sourcePageLabel}}</span><button data-action="nextSources" {{#unless hasNextSources}}disabled{{/unless}}>Next <i class="fa-solid fa-arrow-right"></i></button></div>
      </section>
    {{/if}}

    {{#if steps.basics}}
      <section class="ls-builder-step">
        <h2>Identity</h2>
        <p>The document remains a native PF2e <strong>{{item.typeLabel}}</strong>. Type changes are handled by Foundry when the item is created.</p>
        <div class="ls-form-grid">
          <label class="wide">Item name<input name="name" value="{{item.name}}"></label>
          <label>Level<select name="level">{{#each itemLevels}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
          <label>Rarity<select name="rarity">{{#each rarityOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
          <label class="wide">Add a native PF2e trait<span class="ls-inline-control"><select name="traitToAdd"><option value="">Choose a trait</option>{{#each itemTraitOptions}}<option value="{{value}}">{{label}}</option>{{/each}}</select><button type="button" data-action="addTrait">Add</button></span></label>
          <div class="ls-trait-chips wide">{{#each item.traits}}<button type="button" class="ls-trait-chip" data-action="removeTrait" data-trait="{{value}}">{{label}} <i class="fa-solid fa-xmark"></i></button>{{else}}<span>No traits selected.</span>{{/each}}</div>
        </div>
      </section>
    {{/if}}

    {{#if steps.mechanics}}
      <section class="ls-builder-step">
        <h2>{{item.typeLabel}} mechanics</h2>
        <p>Only fields supported by this PF2e item type are shown. These values write directly to the system item document.</p>
        {{#if item.isPhysical}}
          <section class="ls-builder-card"><h3>Physical item</h3><div class="ls-form-grid stats">
            <label>Quantity<input name="quantity" type="number" min="1" value="{{item.quantity}}"></label>
            <label>Bulk<select name="bulk">{{#each bulkOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
            {{#if item.hasUsage}}<label>Usage<select name="usage">{{#each usageOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}
            <label>Hardness<input name="hardness" type="number" min="0" value="{{item.hardness}}"></label>
            <label>Base maximum HP<input name="hpMax" type="number" min="0" value="{{item.hpMax}}"><small>Damage already taken is preserved. Runes and materials can raise the final maximum.</small></label>
          </div><h4>Price</h4><div class="ls-coin-grid"><label>PP<input name="pricePP" type="number" min="0" value="{{item.price.pp}}"></label><label>GP<input name="priceGP" type="number" min="0" value="{{item.price.gp}}"></label><label>SP<input name="priceSP" type="number" min="0" value="{{item.price.sp}}"></label><label>CP<input name="priceCP" type="number" min="0" value="{{item.price.cp}}"></label></div></section>
        {{/if}}

        {{#if item.weapon}}<section class="ls-builder-card"><h3>Weapon statistics</h3><div class="ls-form-grid stats">
          <label>Category<select name="category">{{#each weaponCategories}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
          <label>Group<select name="group"><option value="">None</option>{{#each weaponGroups}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
          <label>Damage dice<input name="damageDice" type="number" min="1" max="8" value="{{item.damageDice}}"></label>
          <label>Damage die<select name="damageDie">{{#each dieOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}</select></label>
          <label>Damage type<select name="damageType">{{#each damageTypes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
          <label>Range increment<input name="range" type="number" min="0" value="{{item.range}}" placeholder="Blank for melee"></label>
          <label>Reload<input name="reload" value="{{item.reload}}" placeholder="Blank, 0, 1..."></label><label>Splash damage<input name="splashDamage" type="number" min="0" value="{{item.splashDamage}}"></label>
        </div></section>{{/if}}

        {{#if item.armor}}<section class="ls-builder-card"><h3>Armor statistics</h3><div class="ls-form-grid stats">
          <label>Category<select name="category">{{#each armorCategories}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
          <label>Group<select name="group"><option value="">None</option>{{#each armorGroups}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
          <label>AC bonus<input name="acBonus" type="number" value="{{item.acBonus}}"></label><label>Dexterity cap<input name="dexCap" type="number" value="{{item.dexCap}}"></label>
          <label>Strength requirement<input name="strength" type="number" min="0" value="{{item.strength}}"></label><label>Check penalty<input name="checkPenalty" type="number" value="{{item.checkPenalty}}"></label>
          <label>Speed penalty<input name="speedPenalty" type="number" value="{{item.speedPenalty}}"></label>
        </div></section>{{/if}}

        {{#if item.shield}}<section class="ls-builder-card"><h3>Shield statistics</h3><div class="ls-form-grid"><label>AC bonus<input name="acBonus" type="number" value="{{item.acBonus}}"></label><label>Speed penalty<input name="speedPenalty" type="number" value="{{item.speedPenalty}}"></label></div></section>{{/if}}

        {{#if item.consumable}}<section class="ls-builder-card"><h3>Consumable statistics</h3><div class="ls-form-grid stats">
          {{#if item.hasCategory}}<label>Category<select name="category">{{#each consumableCategories}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}
          <label>Current uses<input name="usesValue" type="number" min="0" value="{{item.usesValue}}"></label><label>Maximum uses<input name="usesMax" type="number" min="1" value="{{item.usesMax}}"></label>
          <label class="ls-check-label"><input name="autoDestroy" type="checkbox" {{#if item.autoDestroy}}checked{{/if}}> Destroy when empty</label>
        </div></section>{{/if}}
        {{#if hasRunes}}<section class="ls-builder-card"><h3>Runes</h3><p>PF2e calculates the rune benefits. Enter the base damage dice above; do not add striking dice a second time. Property runes normally need an available potency slot.</p><div class="ls-form-grid">
          <label>Potency<select name="runePotency">{{#each runePotencyOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
          <label>{{#if item.weapon}}Striking rune{{else}}Resilient rune{{/if}}<select name="runeTier">{{#each runeTierOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
          {{#each propertyRuneSlots}}<label>Property rune<select name="propertyRune"><option value="">None</option>{{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/each}}
        </div><p><a href="https://2e.aonprd.com/Rules.aspx?ID=3162" target="_blank" rel="noopener noreferrer">Read the rune rules on Archives of Nethys</a></p></section>{{/if}}
        {{#if hasShieldRunes}}<section class="ls-builder-card"><h3>Shield reinforcing rune</h3><label>Reinforcing tier<select name="runeReinforcing">{{#each reinforcingOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><p>PF2e applies the increase and durability limits to the base shield. Review the resulting hardness and HP before finishing.</p></section>{{/if}}
        {{#if hasMaterial}}<section class="ls-builder-card"><h3>Precious material</h3><div class="ls-form-grid">
          {{#if nativeMaterialOptions}}<label class="wide">Material and grade<select name="nativeMaterial">{{#each nativeMaterialOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
          {{else}}<label>Material<select name="materialType"><option value="">None</option>{{#each materialOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label>Grade<select name="materialGrade">{{#each materialGradeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}
        </div><p>Material, grade, Bulk, and item type affect eligibility and price. Specific magic items can restrict changes. <a href="https://2e.aonprd.com/Rules.aspx?ID=3188" target="_blank" rel="noopener noreferrer">Check material rules</a>.</p></section>{{/if}}
        <section class="ls-builder-card"><h3>Level and price check</h3><p>For a level {{priceGuidance.level}} {{#if priceGuidance.consumable}}consumable{{else}}permanent magic item{{/if}}, the usual price range is <strong>{{priceGuidance.band}}</strong>. Your current final price is {{priceGuidance.gp}} gp. Mundane equipment and specific items may fall outside this guide.</p><p>Compare the strength, action cost, frequency, and restrictions of similar items before setting a level. <a href="{{priceGuidance.url}}" target="_blank" rel="noopener noreferrer">AoN price guidelines</a></p>
          <button type="button" data-action="compareItems"><i class="fa-solid fa-scale-balanced"></i> Find similar official items</button>
          {{#if comparisonsLoaded}}<p>These installed PF2e examples have the same item type, nearby levels, and matching traits where possible. They are starting points for comparison, not a balance score.</p><div class="ls-builder-comparisons">{{#each comparisons}}<details><summary>{{name}} — level {{level}} — {{price}}</summary><p>Usage {{usage}} · Bulk {{bulk}}</p><div class="ls-preview-traits">{{#each traits}}<span>{{this}}</span>{{/each}}</div><div class="ls-preview-description">{{{description}}}</div></details>{{else}}<p>No official same-type items within two levels were found in installed PF2e compendiums. Use Starting point to broaden the search.</p>{{/each}}</div>{{/if}}
        </section>
        <section class="ls-builder-card"><h3>Rules text</h3><textarea name="description" rows="10" placeholder="Describe the item and its constant effects. Structured activation and roll buttons are added in the next steps.">{{item.description}}</textarea></section>
      </section>
    {{/if}}

    {{#if steps.activation}}
      <section class="ls-builder-step"><div class="ls-section-heading"><div><h2>Activations</h2><p>Add every way this item can be activated. Each becomes an entry in the item description and an Action on its owner’s sheet. Next, assign bonuses and roll buttons in Effects.</p></div><button data-action="addActivation"><i class="fa-solid fa-plus"></i> Add activation</button></div>
        <div class="ls-builder-tip"><span><strong>Example:</strong> “Activate on yourself, once per day, for 1 minute” + a fire resistance effect produces an Apply effect button. Clicking it creates a timed Effect on the owner and spends one recorded activation use. It does not apply resistance merely because the item is equipped.</span></div>
        <div class="ls-activation-stack">
          {{#each activations}}
            <section class="ls-builder-card ls-activation-card" data-activation-id="{{id}}">
              <header><div><small>Activation {{number}}</small><strong>{{#if name}}{{name}}{{else}}Unnamed activation{{/if}}</strong></div><button class="danger" data-action="removeActivation" data-id="{{id}}"><i class="fa-solid fa-trash"></i></button></header>
              <div class="ls-form-grid stats">
                <label class="wide">Activation name<input name="activationName" value="{{name}}" placeholder="Courageous Anthem, Counter Performance..."></label>
                <label>Action type<select name="activationType">{{#each activationTypeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                <label>Action cost<select name="activationActions">{{#each activationActionOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                <label>Uses per period<input name="activationFrequencyMax" type="number" min="0" value="{{frequencyMax}}" placeholder="Blank if unlimited"></label>
                <label>Period<select name="activationFrequencyPer">{{#each frequencyOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                <label class="wide">Activation traits<span class="ls-inline-control"><select name="activationTraitToAdd"><option value="">Choose an action trait</option>{{#each activationTraitOptions}}<option value="{{value}}">{{label}}</option>{{/each}}</select><button data-action="addActivationTrait" data-id="{{id}}">Add</button></span></label>
                <div class="ls-trait-chips wide">{{#each traitChips}}<button class="ls-trait-chip" data-action="removeActivationTrait" data-id="{{../id}}" data-trait="{{value}}">{{label}} <i class="fa-solid fa-xmark"></i></button>{{else}}<span>No activation traits.</span>{{/each}}</div>
                <label class="wide">Trigger<input name="activationTrigger" value="{{trigger}}" placeholder="Only used when the activation has a trigger"></label>
                <label class="wide">Requirements<input name="activationRequirements" value="{{requirements}}" placeholder="What must be true before activation"></label>
                <label>Range<input name="activationRange" value="{{range}}" placeholder="touch, 30 feet..."></label><label>Targets<input name="activationTarget" value="{{target}}" placeholder="1 creature, all allies..."></label>
                <label>Area<select name="activationAreaType">{{#each areaOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label>Area size (feet)<input name="activationAreaSize" type="number" min="0" value="{{areaSize}}"></label>
                <label class="wide">Who receives automatic bonuses?<select name="activationApplyTo">{{#each applyToOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select><small>Targeted creatures must be editable by the person applying the effect. Ask the GM for other targets.</small></label>
                <label>Duration amount<input name="activationDurationValue" type="number" min="1" step="1" value="{{durationValue}}"></label>
                <label>Track duration as<select name="activationDurationUnit">{{#each durationUnitOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                <label class="wide">In combat, expire at<select name="activationDurationExpiry">{{#each durationExpiryOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                <label class="wide">Special duration / ending condition<input name="activationDuration" value="{{duration}}" placeholder="Ends early if you attack; handled manually"><small>Track special ending conditions yourself. Foundry uses its world clock and encounter tracking for the duration above; expired-effect handling follows PF2e settings.</small></label>
                <label class="wide">Effect<textarea name="activationEffectText" rows="4" placeholder="Describe what this activation does. Roll buttons are assigned in the next step.">{{effectText}}</textarea></label>
              </div>
            </section>
          {{else}}
            <div class="ls-builder-empty"><i class="fa-solid fa-hand-sparkles"></i><strong>This item has no activation.</strong><span>Add one only if the item has an Activate entry.</span></div>
          {{/each}}
        </div>
      </section>
    {{/if}}

    {{#if steps.automation}}
      <section class="ls-builder-step"><h2>Effects and automation</h2><p>Choose <strong>Constant while worn / held correctly</strong> for ongoing benefits. Choose an <strong>activation</strong> for a bonus that starts only after its Apply effect button is clicked. Damage/healing and saves create roll links; conditions remain reminders.</p>
        <details class="ls-builder-card"><summary>What does Foundry handle?</summary><p>Constant bonuses follow the item’s native equipped and invested state. Activated bonuses become a separate Effect with a tracked duration. Bonuses of the same type follow PF2e stacking rules.</p><p>You still check action costs, range, line of effect, requirements, saves, and special ending conditions. Roll damage/healing and apply the result yourself. Consumable charges and quantity are used from the native item sheet; Apply effect does not consume them.</p></details>
        <div class="ls-effect-add"><select name="effectKindToAdd">{{#each effectKindOptions}}<option value="{{value}}">{{label}}</option>{{/each}}</select><button data-action="addEffect"><i class="fa-solid fa-plus"></i> Add effect</button></div>
        <div class="ls-effect-stack">
          {{#each effects}}<article class="ls-effect-card" data-effect-id="{{id}}" data-effect-kind="{{kind}}"><header><div><span>{{kind}}</span><strong>{{#if label}}{{label}}{{else}}New effect{{/if}}</strong></div><button class="danger" data-action="removeEffect" data-id="{{id}}"><i class="fa-solid fa-trash"></i></button></header><div class="ls-form-grid stats">
            <label>When does this happen?<select name="effectActivationId">{{#each activationOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
            <label>Label<input name="effectLabel" value="{{label}}" placeholder="Shown beside the roll or modifier"></label>
            {{#if isDamage}}<label>Damage formula<input name="effectFormula" value="{{formula}}" placeholder="2d6+4"></label><label>Damage type<select name="effectDamageType"><option value="">Untyped</option>{{#each damageTypes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}
            {{#if isHealing}}<label>Healing formula<input name="effectFormula" value="{{formula}}" placeholder="2d8+8"></label>{{/if}}
            {{#if isCheck}}<label>Defense<select name="effectSave">{{#each saves}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label>DC<input name="effectDc" type="number" value="{{dc}}" placeholder="Leave blank for a prompt"></label><label class="ls-check-label"><input name="effectBasic" type="checkbox" {{#if basic}}checked{{/if}}> Basic save</label>{{/if}}
            {{#if isCondition}}<label>Condition or effect<input name="effectCondition" value="{{condition}}" placeholder="frightened 1, off-guard..."></label>{{/if}}
            {{#if isFlatModifier}}<label>Statistic to change<input name="effectSelector" list="ls-selector-{{id}}" value="{{selector}}" placeholder="Choose or type a statistic"><datalist id="ls-selector-{{id}}">{{#each selectorOptions}}<option value="{{value}}">{{label}}</option>{{/each}}</datalist><small>For example, ac = Armor Class and athletics = Athletics.</small></label><label>Bonus / penalty<input name="effectValue" type="number" value="{{value}}"></label><label>Bonus type<select name="effectModifierType">{{#each modifierTypes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}
            {{#if isDamageDice}}<label>Which damage rolls?<input name="effectSelector" value="{{selector}}" placeholder="strike-damage"><small>strike-damage affects all Strikes. Specific weapon selectors are an advanced option.</small></label><label>Extra dice<input name="effectFormula" value="{{formula}}" placeholder="1d6"></label><label>Damage type<select name="effectDamageType"><option value="">Use base damage</option>{{#each damageTypes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}
            {{#if isResistance}}<label>Resistance type<select name="effectDamageType">{{#each effectTypes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label>Value<input name="effectValue" type="number" value="{{value}}"></label>{{/if}}
            {{#if isWeakness}}<label>Weakness type<select name="effectDamageType">{{#each effectTypes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label>Value<input name="effectValue" type="number" value="{{value}}"></label>{{/if}}
            {{#if isImmunity}}<label>Immunity type<select name="effectDamageType">{{#each effectTypes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}
            {{#if isFastHealing}}<label>Value<input name="effectValue" type="number" min="0" value="{{value}}"></label><label class="ls-check-label"><input name="effectOption" type="checkbox" value="regeneration" {{#if regeneration}}checked{{/if}}> Regeneration</label>{{/if}}
            {{#if isRollOption}}<label>Domain<input name="effectSelector" value="{{selector}}" placeholder="all"></label><label>Roll option<input name="effectOption" value="{{option}}" placeholder="my-item-active"></label>{{/if}}
            {{#if isDamage}}<label class="wide">Rules note<input name="effectNote" value="{{note}}" placeholder="Critical failure doubles damage..."></label>{{/if}}{{#if isHealing}}<label class="wide">Rules note<input name="effectNote" value="{{note}}"></label>{{/if}}{{#if isCheck}}<label class="wide">Rules note<input name="effectNote" value="{{note}}"></label>{{/if}}{{#if isCondition}}<label class="wide">Rules note<input name="effectNote" value="{{note}}"></label>{{/if}}
          </div></article>{{else}}<div class="ls-builder-empty">No modular effects yet. Constant descriptive effects can remain in the rules text.</div>{{/each}}
        </div>
        <div class="ls-builder-tip"><i class="fa-solid fa-gears"></i><span>{{nativeRuleCount}} existing native PF2e rules will be preserved. {{generatedRuleCount}} constant rules and {{activatedRuleCount}} activation-bound rules are configured.</span></div>
      </section>
    {{/if}}

    {{#if steps.review}}
      <section class="ls-builder-step ls-builder-review"><i class="fa-solid fa-hammer"></i><h2>{{item.name}}</h2><p>Level {{item.level}} &middot; {{item.rarity}} {{item.typeLabel}}</p>
        <div class="ls-validation {{#if valid}}valid{{else}}warning{{/if}}"><h3>{{#if valid}}Ready for the native sheet{{else}}Check these fields{{/if}}</h3>{{#each validation}}<p><i class="fa-solid fa-triangle-exclamation"></i> {{this}}</p>{{else}}<p><i class="fa-solid fa-check"></i> The required fields and modular effects are valid.</p>{{/each}}</div>
        <article class="ls-final-statblock ls-builder-card"><header><h3>{{item.name}}</h3><span>{{item.typeLabel}} {{item.level}}</span></header><div class="ls-preview-traits"><span>{{item.rarity}}</span>{{#each item.traits}}<span>{{label}}</span>{{/each}}</div>
          <p><strong>Price</strong> {{item.price.pp}} pp, {{item.price.gp}} gp, {{item.price.sp}} sp, {{item.price.cp}} cp; <strong>Bulk</strong> {{item.bulk}}; <strong>Usage</strong> {{item.usage}}</p>
          {{#if item.weapon}}<p><strong>Damage</strong> {{item.damageDice}}{{item.damageDie}} {{item.damageType}}; <strong>Category</strong> {{item.category}}; <strong>Group</strong> {{item.group}}; <strong>Range</strong> {{item.range}}; <strong>Reload</strong> {{item.reload}}; <strong>Splash</strong> {{item.splashDamage}}</p>{{/if}}
          {{#if item.armor}}<p><strong>AC bonus</strong> {{item.acBonus}}; <strong>Dex cap</strong> {{item.dexCap}}; <strong>Strength</strong> {{item.strength}}; <strong>Check penalty</strong> {{item.checkPenalty}}; <strong>Speed penalty</strong> {{item.speedPenalty}}</p>{{/if}}
          {{#if item.shield}}<p><strong>AC bonus</strong> {{item.acBonus}}; <strong>Speed penalty</strong> {{item.speedPenalty}}</p>{{/if}}
          <p><strong>Hardness</strong> {{item.hardness}}; <strong>HP</strong> {{item.hpValue}} / {{item.hpMax}}; <strong>Quantity</strong> {{item.quantity}}</p>
          {{#if item.consumable}}<p><strong>Uses</strong> {{item.usesValue}} / {{item.usesMax}}</p>{{/if}}
          {{#if hasRunes}}<p><strong>Potency</strong> +{{item.runePotency}}; <strong>{{#if item.weapon}}Striking{{else}}Resilient{{/if}} tier</strong> {{item.runeTier}}; <strong>Property runes</strong> {{item.runeNames}}</p>{{/if}}
          {{#if item.materialType}}<p><strong>Material</strong> {{item.materialType}} ({{item.materialGrade}})</p>{{/if}}
          <div class="ls-preview-description">{{{previewDescription}}}</div>
        </article>
        <section class="ls-builder-card"><h3>What happens at the table</h3>{{#each resultRows}}<p><strong>{{label}}</strong> — {{behavior}}</p>{{else}}<p>The item’s normal PF2e statistics and copied native rules apply. No additional Lore Smith effects are configured.</p>{{/each}}<p>Written requirements, action costs, range, special endings, saving-throw outcomes, and consumable charges still need a player or GM. Test the item on a spare actor before handing it to players.</p></section>
        {{#if hasWarnings}}<section class="ls-validation warning"><h3>GM review</h3>{{#each warnings}}<p>{{this}}</p>{{/each}}</section>{{/if}}
        <p>Finish saves the reviewed automation and reopens the native PF2e item sheet. Existing copied rules are preserved.</p>
        <button data-action="finish" {{#unless valid}}disabled{{/unless}}><i class="fa-solid fa-check"></i> Finish item</button>
      </section>
    {{/if}}
  </main>

  <footer class="ls-builder-navigation"><div>{{#if canBack}}<button class="round" data-action="previous"><i class="fa-solid fa-arrow-left"></i></button>{{/if}}</div><span>Changes are saved to {{item.name}}</span><div>{{#if canNext}}<button class="round" data-action="next"><i class="fa-solid fa-arrow-right"></i></button>{{/if}}</div></footer>
</section>
