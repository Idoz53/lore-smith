<section class="ls-live-combat">
  <header>
    <div><strong>Live combat log</strong><small>{{status}}</small></div>
    <label>Seconds per action
      <input name="liveDelay" type="range" min="250" max="10000" step="250" value="{{delay}}">
      <span data-role="delayLabel">{{delaySeconds}} seconds</span>
    </label>
    <div class="ls-live-controls">
      <button type="button" data-action="togglePause" {{#unless running}}disabled{{/unless}}>
        {{#if paused}}<i class="fa-solid fa-play"></i> Resume{{else}}<i class="fa-solid fa-pause"></i> Pause{{/if}}
      </button>
      <button type="button" class="danger" data-action="stop" {{#unless running}}disabled{{/unless}}>
        <i class="fa-solid fa-stop"></i> Stop
      </button>
    </div>
  </header>
  {{#if summary}}
    <section class="ls-live-summary">
      <article><span>Victory estimate</span><strong>{{summary.victoryRate}}</strong><small>{{summary.iterations}} test combats</small></article>
      <article><span>PF2e difficulty</span><strong>{{summary.difficulty}}</strong><small>{{summary.difficultyDetail}}</small></article>
      <article><span>Expected length</span><strong>{{summary.averageRounds}}</strong><small>rounds</small></article>
    </section>
  {{/if}}
  {{#if coverageHtml}}
    <details class="ls-live-coverage">
      <summary><i class="fa-solid fa-clipboard-check"></i> Simulation coverage</summary>
      {{{coverageHtml}}}
    </details>
  {{/if}}
  <div class="ls-live-notice"><i class="fa-solid fa-shield-halved"></i> Isolated replay: the real Scene, actors, HP, conditions, inventory, spell slots, targets, templates, and Combat Tracker are never changed.</div>
  <div class="ls-live-workspace">
    <section class="ls-live-stage" data-role="battlefield" aria-label="Isolated combat battlefield">
      <div class="ls-live-stage-caption" data-role="battlefieldCaption">Preparing isolated combat...</div>
      <svg class="ls-live-stage-overlays" data-role="battlefieldOverlay" aria-hidden="true"></svg>
      <div class="ls-live-stage-tokens" data-role="battlefieldTokens"></div>
    </section>
    <div class="ls-live-entries">
      {{#each entries}}<p class="{{kind}}" data-entry-index="{{index}}">{{text}}</p>{{else}}<p class="empty">Waiting for the first action...</p>{{/each}}
    </div>
  </div>
  <footer class="ls-live-timeline">
    <button type="button" data-action="previousEntry" {{#if timelineAtStart}}disabled{{/if}} title="Previous logged action"><i class="fa-solid fa-chevron-left"></i></button>
    <input name="timelineIndex" type="range" min="0" max="{{timelineMax}}" step="1" value="{{timelineIndex}}" {{#unless hasTimelineEntries}}disabled{{/unless}}>
    <span data-role="timelineLabel">Action {{timelinePosition}} of {{timelineTotal}}</span>
    <button type="button" data-action="nextEntry" {{#if timelineAtEnd}}disabled{{/if}} title="Next logged action"><i class="fa-solid fa-chevron-right"></i></button>
  </footer>
</section>
